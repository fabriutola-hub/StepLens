{
  "name": "@agent-replay/otel",
  "version": "0.8.0",
  "description": "OpenTelemetry bridge for StepLens — convert and export traces to OTLP/HTTP JSON.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabriutola-hub/StepLens.git",
    "directory": "packages/otel"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@agent-replay/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
