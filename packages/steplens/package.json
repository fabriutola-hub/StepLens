{
  "name": "steplens",
  "version": "0.8.0",
  "description": "Local-first trace inspector for AI agents — install and run Studio with `npx steplens dev`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabriutola-hub/StepLens.git",
    "directory": "packages/steplens"
  },
  "type": "module",
  "bin": {
    "steplens": "./dist/index.js",
    "agent-replay": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
